#!/usr/bin/env python3
"""Run midi-tempo from a checkout, even through a symlink."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

if __name__ == "__main__":  # worker processes re-import this file; only the real run does the work
    from midi_tempo.cli import run

    sys.exit(run())
